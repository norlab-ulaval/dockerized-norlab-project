#!/bin/bash
# bin/dna

# ....Bash version note............................................................................
# DNA currently supports bash >= 3.2 (the version shipped with macOS by default). Some optional
# patch-chain features (associative arrays, `declare -A`, etc.) require bash >= 4 and MUST NOT be
# used by individual patches unless they are also compatibility-wrapped. No user-facing advisory
# is emitted for bash < 4: this information is relevant to DNA developers only. Developers can opt
# in to the diagnostic by exporting DNA_DEBUG=1.
if [[ -n "${DNA_DEBUG:-}" \
      && -n "${BASH_VERSINFO[0]}" \
      && "${BASH_VERSINFO[0]}" -lt 4 \
      && -z "${DNA_BASH_VERSION_WARNED:-}" ]]; then
    export DNA_BASH_VERSION_WARNED=1
    printf '\033[1;33m[dna dev]\033[0m Running under bash %s. DNA supports this version, but some advanced shell features (e.g. associative arrays) are unavailable; third-party or legacy patches that rely on them may degrade gracefully with a warning.\n' \
        "${BASH_VERSION:-unknown}" 1>&2
fi

DOCUMENTATION_BUFFER_DNA=$( cat <<'EOF'
# =================================================================================================
#                            Dockerized-NorLab project application (DNA)
#                         A tool for managing Docker-based robotic projects
#
# Usage:
#   $ dna COMMAND [OPTIONS]
#
# Commands:
#   init        Initialize a new DNA project
#   build       Build DNA Docker images
#   up          Start and attach to a container (daemon mode)
#   down        Stop containers
#   attach      Attach to a running container
#   exec        Execute command in a running container
#   run         Run a command in a container
#   project     Super project commands
#   save        Save DNA Docker image to file for offline use
#   load        Load DNA Docker image from file for offline use
#   config      Show parsed docker compose configuration
#   version     Show DNA version
#   update      Update DNA to latest version
#   help        Show this help message
#
# Run 'dna COMMAND --help' for more information on a command.
#
# =================================================================================================
EOF
)

# ....Find path to script........................................................................
# Note: can handle both sourcing cases
#   i.e. from within a script or from an interactive terminal session
# Check if running interactively
if [[ $- == *i* ]]; then
  # Case: running in an interactive session
  _target_path=$(realpath .)
else
  # Case: running in an non-interactive session
  _script_path="$(realpath -q "${BASH_SOURCE[0]:-.}")"
  _target_path="$(dirname "${_script_path}")"
fi
dna_core="$(dirname "${_target_path}")/lib/core"

# ::::Load dependencies::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
source "${dna_core}/utils/import_dna_lib.bash" || exit 1

# ::::Pre-condition::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
dna_error_prefix="\033[1;31m[dna error]\033[0m"
test -n "$( declare -f dna::import_lib_and_dependencies )" || { echo -e "${dna_error_prefix} The DNA lib is not loaded!" 1>&2 && exit 1; }
test -n "$( declare -f n2st::print_msg )" || { echo -e "${dna_error_prefix} The N2ST lib is not loaded!" 1>&2 && exit 1; }
test -d "${DNA_ROOT:?err}" || { echo -e "${dna_error_prefix} library load error!" 1>&2 && exit 1; }
test -d "${DNA_LIB_PATH:?err}" || { echo -e "${dna_error_prefix} library load error!" 1>&2 && exit 1; }


# ::::Helper fonctions:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

# =================================================================================================
# Run daily auto-update if conditions are met.
#
# Performs an automatic update of the DNA system only when all conditions are satisfied:
#   1. auto-update is enabled;
#   2. system is online;
#   3. and daily update is due.
# The function updates the timestamp first to prevent multiple concurrent runs, then executes the
# update silently.
#
# Usage:
#   $ dna::run_daily_auto_update
#
# Returns:
#   0 on success (including when auto-update is disabled or already run today)
#   1 on update command failure
#
# =================================================================================================
function dna::run_daily_auto_update() {
    local tmp_cwd
    tmp_cwd=$(pwd)

    # Run daily auto-update if conditions are met
    source "${DNA_LIB_PATH:?err}/core/utils/update_helper.bash" || return 1

    if ! dna::is_online; then
      # Check if online
      n2st::print_msg_warning "Be advised, you are currently offline, skipping auto-update."
      return 0
    elif [[ "$(dna::update_get_auto_update_setting)" != "true" ]]; then
      # Check if auto-update is enabled
      return 0  # Auto-update disabled, skip
    elif ! dna::should_run_daily_update; then
      # Check if we should run update today
      return 0  # Already updated today, skip
    fi

    # Update timestamp first to prevent multiple runs
    dna::update_timestamp

    # Run the update silently
    source "${DNA_LIB_PATH}/commands/update.bash" || return 1
    dna::update_command --yes || return 1

    cd "${tmp_cwd}" || { n2st::print_msg_error "Return to original dir error"; return 1; }
    return 0
}

# ::::Command functions::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
function dna::entrypoint() {

  # ....Set env variables (pre cli)................................................................
  local the_command="$1"
  shift || true

  # ....Auto-update check (run early, before processing commands).................................
  # Skip auto-update for help, version, and update commands to avoid recursion/interference
  if [[ ! "${the_command}" =~ .*(help|--help|-h|version|update).* ]]; then
    dna::run_daily_auto_update || n2st::print_msg_warning "Be advised, auto-update failed. Continue anyway"

    # Configuration scheme patching trigger is:
    # 1. Bound to 'dna project [validate|sanity]'
    # 2. General trigger only when running inside a super project root
    if [[ -d ".dockerized_norlab" ]]; then
        dna::patch_check_and_run || n2st::print_msg_warning "Be advised, configuration scheme patching failed. Continue anyway"
    fi
  fi

  # ....cli........................................................................................
  if [[ -z ${the_command}  ]]; then
    dna::show_entrypoint_help "${DOCUMENTATION_BUFFER_DNA:?err}"
    exit 0
  fi

  case "${the_command}" in
      init)
          source "${DNA_LIB_PATH}/commands/init.bash" || exit 1
          dna::init_command "$@"
          exit $?
          ;;
      build)
          source "${DNA_LIB_PATH}/commands/build.bash" || exit 1
          dna::build_command "$@"
          exit $?
          ;;
      save)
          source "${DNA_LIB_PATH}/commands/save.bash" || exit 1
          dna::save_command "$@"
          exit $?
          ;;
      load)
          source "${DNA_LIB_PATH}/commands/load.bash" || exit 1
          dna::load_command "$@"
          exit $?
          ;;
      exec)
          source "${DNA_LIB_PATH}/commands/exec.bash" || exit 1
          dna::exec_command "$@"
          exit $?
          ;;
      attach)
          source "${DNA_LIB_PATH}/commands/attach.bash" || exit 1
          dna::attach_command "$@"
          exit $?
          ;;
      up)
          source "${DNA_LIB_PATH}/commands/up.bash" || exit 1
          dna::up_command "$@"
          exit $?
          ;;
      down)
          source "${DNA_LIB_PATH}/commands/down.bash" || exit 1
          dna::down_command "$@"
          exit $?
          ;;
      run)
          source "${DNA_LIB_PATH}/commands/run.bash" || exit 1
          dna::run_command "$@"
          exit $?
          ;;
      config)
          source "${DNA_LIB_PATH}/commands/config.bash" || exit 1
          dna::config_command "$@"
          exit $?
          ;;
      version)
          source "${DNA_LIB_PATH}/commands/version.bash" || exit 1
          dna::version_command "$@"
          exit $?
          ;;
      update)
          source "${DNA_LIB_PATH}/commands/update.bash" || exit 1
          dna::update_command "$@"
          exit $?
          ;;
      project)
          sub_the_command="$1"
          shift || true

          source "${DNA_LIB_PATH}/commands/project.bash" || exit 1
          if [[ -z ${sub_the_command}  ]]; then
            dna::command_help_menu "${DOCUMENTATION_BUFFER_PROJECT:?err}"
            exit 0
          fi

          case "${sub_the_command}" in
              validate)
                  dna::project_validate_command "$@"
                  exit $?
                  ;;
              sanity)
                  dna::project_sanity_command "$@"
                  exit $?
                  ;;
              init_secrets)
                  dna::project_init_secrets_command "$@"
                  exit $?
                  ;;
              dotenv)
                  dna::project_dotenv_command "$@"
                  exit $?
                  ;;
              help|--help|-h)
                  dna::command_help_menu "${DOCUMENTATION_BUFFER_PROJECT:?err}"
                  exit 0
                  ;;
              *)
                  dna::unknown_subcommand_msg "project" "${sub_the_command}"
                  exit 1
                  ;;
          esac
          ;;
      help|--help|-h)
          dna::show_entrypoint_help "${DOCUMENTATION_BUFFER_DNA:?err}"
          exit 0
          ;;
      *)
          dna::unknown_command_msg "${the_command}"
          exit 1
          ;;
  esac
}

# ::::Main:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
dna::entrypoint "$@"
