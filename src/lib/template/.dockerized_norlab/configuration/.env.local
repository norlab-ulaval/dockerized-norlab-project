# =================================================================================================
# Set host bound environment variable.
#
# Notes:
#   - This file is added to '.gitignore' by default so any modification made here will only affect
#     the current host.
#   - This dotenv file is loaded last so it can be use as an environment variables override file.
#     DNA dotenv file loading precedence:
#       1. .env.dna
#       2. .env
#       3. .env.local
#       4. .env.dna-internal (DNA repository)
#
# =================================================================================================

# To mount a host local data directory external to the DNA super-project e.g., "~/Documents/data",
# unmute environment variable "DNA_HOST_SHARED_DATA_PATH" and set it to point to the target data
# directory. It will be mounted as a read-only docker volume in your project dna container at path
# "data/shared_data/". See "data/shared_data/README.md" for details.
#DNA_HOST_SHARED_DATA_PATH="/Path/to/host/computer/shared_data/directory"
