# =================================================================================================
# Minimal mock of the DNA slurm Docker image for Apptainer pipeline testing.
#
# Simulates the essential structure of Dockerfile.run-slurm output without requiring
# the full DN base image or build infrastructure. Used to create a test tar archive
# that Apptainer converts to SIF for integration testing.
#
# Mirrors these key aspects of the real slurm image:
#   - DN_PROJECT_USER, DN_PROJECT_PATH, DN_PROJECT_GIT_NAME environment variables
#   - Entrypoint at /dockerized-norlab/project/project-slurm/dn_entrypoint.init.bash
#   - WORKDIR at DN_PROJECT_PATH/src
#   - NUMBA_CACHE_DIR at /tmp/numba_cache
#   - Apptainer compatibility LABELs
#
# Usage (built automatically by the test orchestrator):
#   $ docker build -f Dockerfile.mock-slurm-image -t dna-mock-slurm .
#   $ docker save dna-mock-slurm -o mock-slurm.tar
#
# =================================================================================================
FROM --platform=linux/amd64 ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

# Install minimal dependencies
# Note: 'git' is required inside the container by the slurm job template's content guard,
# which validates the baked-in super-project '.git' via 'git rev-parse --verify HEAD'.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        git \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# ====Simulate DN environment variables============================================================
ENV DN_PROJECT_USER=testuser
ENV DN_PROJECT_UID=1000
ENV DN_PROJECT_GID=1000
ENV DN_PROJECT_PATH=/ros2_ws/src/mock-project
ENV DN_PROJECT_GIT_NAME=mock-project
ENV DN_PROJECT_GIT_DOMAIN=github.com
ENV DN_PROJECT_SERVICE=project-slurm
ENV DN_PROJECT_SERVICE_DIR=/dockerized-norlab/project/project-slurm
ENV IS_SLURM_RUN=true
ENV NUMBA_CACHE_DIR=/tmp/numba_cache

# ====Create user and directory structure==========================================================
RUN useradd -m -s /bin/bash -u 1000 testuser && \
    mkdir -p "${DN_PROJECT_SERVICE_DIR}" && \
    mkdir -p "${DN_PROJECT_PATH}/src" && \
    mkdir -p "${DN_PROJECT_PATH}/artifact" && \
    mkdir -p "${DN_PROJECT_PATH}/data/external_data" && \
    mkdir -p "${DN_PROJECT_PATH}/data/shared_data" && \
    mkdir -p /tmp/numba_cache && \
    chmod 777 /tmp/numba_cache && \
    mkdir -p /entrypoints/project-slurm && \
    mkdir -p /dn_container_env_variable

# ====Install mock entrypoint=====================================================================
COPY mock_entrypoint.bash "${DN_PROJECT_SERVICE_DIR}/dn_entrypoint.init.bash"
RUN chmod +x "${DN_PROJECT_SERVICE_DIR}/dn_entrypoint.init.bash"

# ====Create a test python script==================================================================
COPY test_apptainer_env.py "${DN_PROJECT_PATH}/src/test_apptainer_env.py"

# ====Bake in a COMPLETE super-project '.git'======================================================
# The real DNA slurm image carries the super-project's '.git' baked in. The slurm job template's
# content guard (and the DN/N2ST entrypoint bootstrap) validate it inside the container with:
#   [ -d .git/objects ] && [ -d .git/refs ] && git --git-dir=.git rev-parse --verify HEAD
# Initialize a minimal but COMPLETE git repository (HEAD + objects + refs) so the guard passes,
# mirroring a known-good SIF conversion.
#
# Robustness notes:
#   - Commit a REAL tracked file (not just --allow-empty) so the repo carries a blob + tree +
#     commit, i.e. a genuine object graph.
#   - 'git repack -adq' + 'git gc' consolidate the loose objects into a single packfile. A packed
#     repo is a handful of files instead of many tiny loose objects, which is markedly more robust
#     across the Docker -> Apptainer SIF (squashfs) conversion.
#   - 'safe.directory=*' is baked system-wide so both the template content guard AND the real
#     entrypoint's 'git rev-parse' succeed regardless of the (host) uid Apptainer runs the container
#     as (Apptainer runs as the invoking user, not the image USER, so '.git' is often not owned by
#     the caller).
#   - The final chained check is a build-time self-test: it runs the EXACT content guard used by the
#     slurm job template, so a broken bake fails the image build immediately instead of silently
#     producing a SIF that later fails test_slurm_job_template.
RUN git config --system --add safe.directory '*' && \
    git -C "${DN_PROJECT_PATH}" init -q && \
    echo "Mock super-project baked-in .git for Apptainer content guard." \
        > "${DN_PROJECT_PATH}/.dna_mock_super_project" && \
    git -C "${DN_PROJECT_PATH}" -c user.email="test@dna.mock" -c user.name="DNA Mock" add -A && \
    git -C "${DN_PROJECT_PATH}" -c user.email="test@dna.mock" -c user.name="DNA Mock" \
        commit -q -m "Mock super-project baked-in .git for Apptainer content guard" && \
    git -C "${DN_PROJECT_PATH}" repack -adq && \
    git -C "${DN_PROJECT_PATH}" gc -q --prune=now && \
    [ -d "${DN_PROJECT_PATH}/.git/objects" ] && \
    [ -d "${DN_PROJECT_PATH}/.git/refs" ] && \
    git --git-dir="${DN_PROJECT_PATH}/.git" rev-parse --verify HEAD >/dev/null

# ====Set ownership================================================================================
RUN chown -R testuser:testuser "${DN_PROJECT_PATH}" "${DN_PROJECT_SERVICE_DIR}" /entrypoints /dn_container_env_variable

WORKDIR ${DN_PROJECT_PATH}/src
USER testuser

# ====Apptainer compatibility labels===============================================================
LABEL dna.apptainer.compatible="true"
LABEL dna.apptainer.entrypoint="/dockerized-norlab/project/project-slurm/dn_entrypoint.init.bash"
LABEL dna.apptainer.target.platform="linux/amd64"

ENTRYPOINT [ "/dockerized-norlab/project/project-slurm/dn_entrypoint.init.bash" ]
CMD [ "-c", "print('>>>Hello-slurm-mock')" ]
